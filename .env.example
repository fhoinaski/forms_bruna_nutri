CLOUDFLARE_ACCOUNT_ID=SEU_ACCOUNT_ID
CLOUDFLARE_D1_DATABASE_ID=SEU_DATABASE_ID
CLOUDFLARE_D1_API_TOKEN=SEU_TOKEN_DA_CLOUDFLARE
CLOUDFLARE_D1_TIMEOUT_MS=15000
SESSION_VERSION_CACHE_TTL_MS=15000

# Cloudflare R2 — credenciais S3-compatible exclusivas do servidor.
# Nunca use NEXT_PUBLIC_ e restrinja o token R2 somente ao bucket necessário.
R2_ACCOUNT_ID=SEU_ACCOUNT_ID
R2_ACCESS_KEY_ID=SUA_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=SUA_R2_SECRET_ACCESS_KEY
R2_PATIENT_FILES_BUCKET=bruna-nutri-patient-files-development

ADMIN_EMAIL=admin@brunafloresnutri.com
ADMIN_PASSWORD=coloque_uma_senha_forte
AUTH_SECRET=gere_uma_chave_grande
MFA_ENCRYPTION_KEY=gere_uma_chave_diferente_com_32_ou_mais_caracteres
# Segredo dedicado para a sessao publica da pre-consulta guiada por IA
# (lib/security/intake-session-token.ts). Nunca reutilize AUTH_SECRET.
# Em producao e obrigatorio (>= 32 bytes). Em dev/teste faz fallback seguro.
PATIENT_INTAKE_SESSION_SECRET=gere_uma_chave_dedicada_com_32_ou_mais_caracteres
# Opcional: chave dedicada para prontuario/evolucoes/respostas de formulario
# (lib/security/encrypted-fields.ts). Se nao definida, usa MFA_ENCRYPTION_KEY
# e depois AUTH_SECRET em cadeia — dado ja cifrado com uma chave antiga
# continua legivel mesmo depois de definir esta variavel (ver lib/security/crypto.ts).
CLINICAL_DATA_ENCRYPTION_KEY=gere_uma_terceira_chave_com_32_ou_mais_caracteres
# Opcionais: somente para leitura/migração de dados cifrados com chaves antigas.
MIGRATION_LEGACY_CLINICAL_KEY=deixe_vazio_se_nao_houver_dados_legados
MIGRATION_LEGACY_MFA_KEY=deixe_vazio_se_nao_houver_dados_legados
BACKUP_ENCRYPTION_KEY=gere_outra_chave_com_32_ou_mais_caracteres
BLOG_AGENT_TOKEN=gere_um_token_exclusivo_para_o_agente
NEXT_PUBLIC_BASE_URL=https://brunanutri.com.br

RESEND_API_KEY=coloque_sua_chave_resend
EMAIL_FROM="Bruna Flores Nutri <contato@brunanutri.com.br>"
CRON_SECRET=gere_um_token_exclusivo_para_os_crons

# Resolver canônico de alimentos — opcional. Ausente equivale a "off".
# Use shadow em ambiente local para observação sem alterar a resposta entregue.
CANONICAL_FOOD_RESOLVER_MODE=off
CANONICAL_FOOD_RESOLVER_MODE_ADMIN_FOOD_SEARCH=off
CANONICAL_FOOD_RESOLVER_MODE_SUBSTITUTIONS=off
CANONICAL_FOOD_RESOLVER_MODE_MEAL_PLAN_AI=off
